{
  "name": "@devscholar/pyodide-tk",
  "private": true,
  "version": "0.0.1",
  "description": "Tcl/Tk + em-x11 + _tkinter as Pyodide-loadable side modules. Lets unmodified Python tkinter programs run in the browser.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "postinstall": "sed -i 's/\\r$//' scripts/setup.sh && bash scripts/setup.sh",
    "build": "pnpm run build:native && pnpm run stage-assets && pnpm run build:web",
    "build:native": "make -j all",
    "build:web": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke:node": "node tests/node-load/smoke.mjs",
    "stage-assets": "bash scripts/stage-assets.sh",
    "clean:all": "rimraf build dist node_modules ignored-area"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "pyodide": "314.0.0-alpha.1",
    "puppeteer": "^24.42.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
